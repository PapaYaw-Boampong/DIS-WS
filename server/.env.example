# Local development environment for the DIS portal backend.
# Copy to .env and adjust as needed.

# Postgres connection string (matches docker-compose.yml).
DATABASE_URL="postgresql://dis:dis@localhost:5432/dis_portal?schema=public"

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed browser origins (the Next.js app).
ALLOWED_ORIGIN="http://localhost:3000"

NODE_ENV=development

# Password assigned to every seeded demo account (dev only).
SEED_PASSWORD="PortalDev123!"

# Cloudflare R2 (S3-compatible) private object storage.
# Create a bucket + an API token in the Cloudflare dashboard under R2 ->
# Manage API tokens (grant Object Read & Write, scoped to this bucket only).
# R2_ACCOUNT_ID is shown on the R2 overview page.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dis-portal-files"
