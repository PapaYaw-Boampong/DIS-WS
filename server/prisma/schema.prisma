// Divine International School portal backend — Prisma schema.
// Phase 15 (auth-first): identity + server-owned sessions only. Later
// increments add academics, finance, transport, files, notifications, and audit
// per PORTAL_DATABASE_SCHEMA_PLAN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PARENT
  STAFF
  ADMIN
  ACCOUNTS
  TRANSPORT
  // The administration portal is split by responsibility: ADMIN runs the
  // school, REGISTRY owns people records and admissions, DEVELOPER owns the
  // platform (accounts + role permissions + readiness).
  REGISTRY
  DEVELOPER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  role         Role
  status       UserStatus @default(ACTIVE)
  passwordHash String
  // Set when an admin resets the password to a temporary one; the portal forces
  // a password change on next sign-in and clears it once changed.
  mustChangePassword Boolean @default(false)
  // TOTP second factor. `mfaSecret` is set while enrolling and stays set once
  // confirmed; `mfaEnabledAt` is what actually gates login, so a half-finished
  // enrolment can never lock someone out of their own account.
  mfaSecret          String?
  mfaEnabledAt       DateTime?
  // Highest TOTP step already accepted, so a code cannot be replayed inside
  // its own validity window.
  mfaLastUsedCounter BigInt?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions                 Session[]
  conversationParticipants ConversationParticipant[]
  authoredMessages         Message[]
  mfaBackupCodes           MfaBackupCode[]
  mfaChallenges            MfaChallenge[]

  @@map("users")
}

// One-time recovery codes for a lost authenticator. Stored as SHA-256 hashes —
// the plaintext is shown to the user once, at enrolment, and never again.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("mfa_backup_codes")
}

// The short-lived ticket issued when a password is correct but the second
// factor is still outstanding. It is NOT a session: it authorises exactly one
// thing, submitting a TOTP code, and expires in minutes.
model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model Session {
  id        String   @id @default(cuid())
  // Only the SHA-256 hash of the opaque session token is stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// --- Identity / people (Increment 3) -------------------------------------
// Domain unions (fee category, statuses, methods, etc.) are stored as strings
// holding the portal's exact lowercase values, so the API returns data the
// Next.js portal consumes without any case remapping. String[] scalar lists
// mirror the mock arrays (parentIds, childIds, classIds, stops...).

model Student {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  studentId        String   @unique
  classId          String?
  className        String?
  level            String
  status           String   @default("active")
  parentIds        String[]
  transportRouteId String?
  feedingPlan      String   @default("none")
  // Registry intake detail. Defaulted rather than required so rows created
  // before the registry existed stay valid.
  dateOfBirth            String @default("")
  gender                 String @default("")
  admissionDate          String @default("")
  previousSchool         String @default("")
  guardianName           String @default("")
  guardianRelationship   String @default("")
  guardianPhone          String @default("")
  guardianEmail          String @default("")
  address                String @default("")
  emergencyContactName   String @default("")
  emergencyContactPhone  String @default("")
  medicalNotes           String @default("")
  createdAt        DateTime @default(now())

  @@index([classId])
  @@map("students")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String?
  fullName  String
  phone     String
  email     String
  childIds  String[]
  status    String   @default("active")
  // Registry intake detail.
  relationship  String @default("")
  alternatePhone String @default("")
  address       String @default("")
  occupation    String @default("")
  idType        String @default("")
  idNumber      String @default("")
  createdAt DateTime @default(now())

  @@map("parents")
}

model Staff {
  id         String   @id @default(cuid())
  userId     String?
  fullName   String
  staffId    String   @unique
  title      String
  classIds   String[]
  subjectIds String[]
  status     String   @default("active")
  // Registry intake detail.
  department     String @default("")
  employmentType String @default("")
  startDate      String @default("")
  qualification  String @default("")
  phone          String @default("")
  email          String @default("")
  address        String @default("")
  // The portal role the registry asked for. Kept even when no account was
  // issued, so whoever holds `accounts.manage` knows what to create.
  requestedPortalRole String @default("")
  // Public website profile (the Leadership & Management page), managed by
  // admins under Website in the portal. The displayed name is always
  // `fullName`, so a registry correction reaches the site with no second edit.
  // Only rows that are `showOnWebsite` AND active are served publicly, and only
  // these fields — never contact details.
  showOnWebsite   Boolean @default(false)
  websitePosition Int     @default(0)
  publicTitle     String  @default("") // e.g. "Principal / Headmaster"; falls back to `title`
  publicRole      String  @default("") // e.g. "Basic & Junior High"
  publicBio       String  @default("")
  publicIcon      String  @default("user-round")
  imageId         String?
  imageObjectKey  String?
  imageAlt        String?
  createdAt  DateTime @default(now())

  @@index([showOnWebsite])
  @@map("staff")
}

// End-of-year progression: one row per learner per academic year, recording
// where they moved from and to. Kept as history so a repeat/transfer decision
// stays auditable after the class rosters have moved on.
model StudentPromotion {
  id           String   @id @default(cuid())
  studentId    String
  academicYear String
  fromClassId  String?
  toClassId    String?
  outcome      String // promote | repeat | graduate | transfer
  recordedById String?
  createdAt    DateTime @default(now())

  @@unique([studentId, academicYear])
  @@index([academicYear])
  @@map("student_promotions")
}

model SchoolClass {
  id           String @id @default(cuid())
  name         String
  level        String
  studentCount Int    @default(0)
  classTeacher String

  @@map("classes")
}

// --- Finance (Increment 4) ------------------------------------------------

model FeeItem {
  id           String  @id @default(cuid())
  title        String
  category     String // school_fees | feeding | transport | admission | miscellaneous | uniform | books | exam | other
  amount       Int
  term         String
  academicYear String
  dueDate      String?

  @@map("fee_items")
}

model Invoice {
  id          String   @id @default(cuid())
  studentId   String
  feeItemIds  String[]
  totalAmount Int
  amountPaid  Int      @default(0)
  balance     Int
  status      String // unpaid | partially_paid | paid | overpaid
  dueDate     String?
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  parentId  String?
  studentId String
  invoiceId String?
  category  String
  amount    Int
  method    String // momo | bank | cash | paystack
  // `initiated` is a payment INTENT (Paystack checkout opened, nothing paid
  // yet): it must never count towards a parent's paid total, never generate a
  // receipt, and never touch Invoice.amountPaid.
  status    String @default("pending") // pending | initiated | verified | rejected | failed | abandoned
  reference String   @unique
  note      String?
  // Provider fields — null for every manually-verified payment.
  provider          String? // "paystack"
  providerReference String? @unique
  providerChannel   String? // card | mobile_money | bank_transfer | ussd
  // Provider fee in PESEWAS (the unit Paystack reports). Every other money
  // column in this schema is whole Ghana cedis; this one is not.
  providerFee       Int?
  providerPaidAt    DateTime?
  providerMessage   String?
  // Bank-deposit metadata (structured fields the parent submits).
  bankName      String?
  depositorName String?
  depositDate   String?
  // OCR-extracted structured data (seam; null until an OCR provider runs).
  ocrData Json?
  // Verification metadata.
  verifiedById      String?
  verifiedAt        DateTime?
  rejectionReason   String?
  receiptDocumentId String?
  paidAt    DateTime @default(now())

  attachment PaymentAttachment?

  @@index([studentId])
  @@index([status])
  @@index([provider, providerReference])
  @@map("payments")
}

// Uploaded bank-deposit receipt. Bytes live in Cloudflare R2 (private
// object storage); this row is metadata only plus the R2 object key.
model PaymentAttachment {
  id        String   @id @default(cuid())
  paymentId String   @unique
  fileName  String
  mimeType  String
  objectKey String
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_attachments")
}

// --- Statement reconciliation (MoMo + Bank) --------------------------------
// The school periodically requests a MoMo/bank statement; an admin uploads it
// (CSV today — PDF/email-import is a documented future seam) and the backend
// parses + auto-matches rows against pending payments of the same method.

model StatementImport {
  id           String   @id @default(cuid())
  method       String // momo | bank
  fileName     String
  // How the rows were obtained: a machine-readable export, or text lifted out
  // of a PDF/photo. Anything derived by OCR is held for human review before it
  // moves money, so the source has to be recorded.
  source       String   @default("csv") // csv | pdf_text | ocr
  importedById String
  importedAt   DateTime @default(now())
  rowCount     Int
  matchedCount Int      @default(0)
  reviewCount  Int      @default(0)

  transactions StatementTransaction[]

  @@map("statement_imports")
}

model StatementTransaction {
  id               String   @id @default(cuid())
  importId         String
  amount           Int
  date             String
  reference        String?
  counterpartyName String?
  raw              Json
  matchedPaymentId String?
  // Parents are told to put the ward's name or ID in the transaction
  // reference, so a statement row usually identifies a LEARNER rather than a
  // payment the parent separately declared.
  matchedStudentId String?
  matchType        String? // reference | amount_date_name | student_id | student_name | manual
  matchConfidence  Int?
  // unmatched | needs_review | confirmed | ignored. Rows that would move money
  // never skip straight to confirmed when they came from OCR.
  status           String   @default("unmatched")
  createdPaymentId String?
  reviewedById     String?
  reviewedAt       DateTime?
  // Raw text line this row was parsed from, so a reviewer can see exactly what
  // the OCR read rather than trusting the parsed fields.
  sourceText       String?
  createdAt        DateTime @default(now())

  import StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([status])
  @@index([matchedStudentId])
  @@map("statement_transactions")
}

// --- Transport (Increment 5) ----------------------------------------------

model TransportRoute {
  id                  String   @id @default(cuid())
  routeName           String
  busName             String
  vehicleRegistration String
  capacity            Int
  driverName          String?
  driverPhone         String?
  // The portal account of the driver who runs this route. Position sharing
  // comes from that driver's phone, so the route needs to know whose phone
  // is allowed to move it.
  driverUserId        String?
  stops               String[]

  @@map("transport_routes")
}

model TransportTrip {
  id          String  @id @default(cuid())
  routeId     String
  date        String
  direction   String
  status      String
  lastUpdated String
  nextStop    String?
  // Live position, shared from the driver's phone while they are on the run.
  // Null means nobody is sharing — the parent view then falls back to the
  // route's planned stops rather than pretending to know where the bus is.
  latitude    Float?
  longitude   Float?
  speedKph    Float?
  // Reported accuracy radius in metres. A phone fix indoors can be kilometres
  // out; showing that as a precise location would mislead a waiting parent.
  accuracyM   Float?
  positionAt  DateTime?
  positionById String?

  @@index([routeId])
  @@map("transport_trips")
}


model TransportAssignment {
  id                   String @id @default(cuid())
  studentId            String
  routeId              String
  pickupPoint          String
  dropOffPoint         String
  estimatedPickupTime  String
  estimatedDropOffTime String
  feeStatus            String

  @@index([studentId])
  @@map("transport_assignments")
}

// --- Documents & notifications (Increment 6) ------------------------------

model DocumentAsset {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String // bill | package | payment_plan | receipt | menu | calendar | announcement | policy
  // audience: all | parent | staff | student (matches a portal role, or "all")
  audience     String   @default("all")
  studentId    String?
  fileName     String?
  url          String?
  // Admin-uploaded file lives in R2 under this key; served via the download
  // endpoint after an audience/role check.
  objectKey    String?
  mimeType     String?
  uploadedById String?
  downloadable Boolean  @default(false)
  publishedAt  String
  createdAt    DateTime @default(now())

  @@map("documents")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("all")
  userId    String?
  priority  String   @default("normal")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// Per-user read state for (mostly broadcast) notifications. Presence of a row
// means the user has read that notification; `GET /me/notifications` derives the
// per-user `read` flag from this table.
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// --- Academics (courses, assessment, timetable) ---------------------------

model Course {
  id          String @id @default(cuid())
  classId     String
  subjectId   String
  subject     String
  title       String
  courseCode  String
  teacher     String
  term        String
  description String
  progress    Int    @default(0)

  @@map("courses")
}

model CourseModule {
  id          String @id @default(cuid())
  courseId    String
  title       String
  description String
  status      String @default("published")
  position    Int    @default(0)
  items       Json // CourseModuleItem[]

  @@index([courseId])
  @@map("course_modules")
}

model AssignmentRecord {
  id             String  @id @default(cuid())
  classId        String
  courseId       String?
  subject        String
  title          String
  instructions   String?
  dueDate        String
  totalStudents  Int?
  submittedCount Int?
  status         String

  @@map("assignments")
}

model TimetableEntry {
  id        String @id @default(cuid())
  classId   String
  className String
  subject   String
  teacher   String
  room      String
  day       String
  startTime String
  endTime   String

  @@map("timetable_entries")
}

model ResultRecord {
  id         String @id @default(cuid())
  studentId  String
  subject    String
  assessment String
  score      Int
  total      Int
  gradedAt   String

  @@index([studentId])
  @@map("results")
}

// End-of-term report card. Built by aggregating GradebookEntry rows for a
// class/term (see server/src/lib/report-cards.ts), held as a draft while
// teachers add remarks, then published to the family in one action. `subjects`
// is denormalised JSON because a published report is a historical statement:
// it must not change when a gradebook entry is later corrected.
model ReportCard {
  id                 String   @id @default(cuid())
  studentId          String
  classId            String?
  className          String
  academicYear       String
  term               String
  status             String   @default("draft") // draft | published
  publishedAt        String?
  overallTotal       Int      @default(0)
  overallPercentage  Int      @default(0)
  positionInClass    Int?
  classSize          Int?
  attendancePresent  Int      @default(0)
  attendanceTotal    Int      @default(0)
  subjects           Json // ReportCardSubject[]
  classTeacher       String   @default("")
  classTeacherRemark String   @default("")
  headTeacherRemark  String   @default("")
  nextTermBegins     String?
  publishedById      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([studentId, academicYear, term])
  @@index([classId, academicYear, term])
  @@index([status])
  @@map("report_cards")
}

model AttendanceSummary {
  id         String @id @default(cuid())
  studentId  String
  term       String
  present    Int
  absent     Int
  late       Int
  percentage Int

  @@index([studentId])
  @@map("attendance_summaries")
}

model DailyAttendanceRecord {
  id        String  @id @default(cuid())
  classId   String
  studentId String
  date      String
  mark      String
  note      String?

  @@unique([classId, studentId, date])
  @@map("daily_attendance")
}

model GradebookEntry {
  id         String @id @default(cuid())
  classId    String
  studentId  String
  subject    String
  assessment String
  score      Int
  total      Int
  status     String

  @@unique([classId, studentId, subject, assessment])
  @@map("gradebook_entries")
}

model LearningResource {
  id        String  @id @default(cuid())
  classId   String
  courseId  String?
  subject   String
  title     String
  fileName  String
  fileType  String
  sharedAt  String
  status    String
  // Bytes live in Cloudflare R2; null for resources that predate real storage
  // or that are external links rather than uploaded files.
  objectKey String?
  mimeType  String?
  fileSize  Int?
  // Real timestamp for deterministic ordering — sharedAt is a day-granularity
  // display date and ties within the same day (e.g. two uploads today).
  createdAt DateTime @default(now())

  @@map("learning_resources")
}

// A student's uploaded file for one assignment. One row per (assignment,
// student) — a re-submission overwrites the same row/object rather than
// stacking duplicates.
model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  fileName     String
  mimeType     String
  objectKey    String
  submittedAt  DateTime @default(now())
  status       String   @default("submitted")

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@map("assignment_submissions")
}

// --- Wallets --------------------------------------------------------------

model FeedingBalance {
  id          String  @id @default(cuid())
  studentId   String  @unique
  balance     Int
  lastTopUpAt String?
  status      String

  @@map("feeding_balances")
}

model TransportWalletBalance {
  id          String  @id @default(cuid())
  studentId   String  @unique
  balance     Int
  lastTopUpAt String?
  status      String

  @@map("transport_wallet_balances")
}

model WalletTransaction {
  id          String @id @default(cuid())
  studentId   String
  wallet      String
  type        String
  amount      Int
  description String
  reference   String
  occurredAt  String

  @@index([studentId])
  @@map("wallet_transactions")
}

// --- Communication --------------------------------------------------------

model Announcement {
  id          String @id @default(cuid())
  title       String
  summary     String
  publishedAt String
  audience    String
  priority    String

  @@map("announcements")
}

model PortalEventRecord {
  id       String  @id @default(cuid())
  title    String
  date     String
  time     String?
  audience String

  @@map("events")
}

model TransportNoticeRecord {
  id          String  @id @default(cuid())
  title       String
  description String
  publishedAt String
  routeId     String?

  @@map("transport_notices")
}

// --- Messages (direct conversations) --------------------------------------
// Viewer-relative fields the portal expects (counterpart, preview, unread,
// fromMe) are computed per request from participants + messages; only the
// durable graph lives here.

model Conversation {
  id        String   @id @default(cuid())
  subject   String
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  sentAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// --- Audit log --------------------------------------------------------------
// Append-only trail for every sensitive write (account lifecycle, financial
// writes/verification, attendance, grades, file upload/download) per
// PORTAL_BACKEND_API_CONTRACT.md section 8. No update/delete path is exposed —
// only recordAudit() (insert) and the admin-only GET /audit-logs read.

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String
  targetId   String?
  summary    String?
  requestId  String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// --- Role permissions -------------------------------------------------------
// What each portal role is allowed to do. Edited by the developer role and
// enforced server-side on every capability-gated write. One row per role;
// a role with no row falls back to the shipped defaults in
// server/src/lib/capabilities.ts (which mirror the portal's own defaults).
model RoleCapability {
  role         String   @id // student | parent | staff | admin | registry | developer | accounts | transport
  capabilities String[]
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@map("role_capabilities")
}

// --- Public forms: mailing list + inquiries --------------------------------
// Captured from the public website; managed by admins in the portal.
model MailingListSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String   @default("")
  consent   Boolean  @default(true)
  status    String   @default("active") // active | unsubscribed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("mailing_list_signups")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  type      String   @default("contact") // contact | admissions
  status    String   @default("new") // new | in_progress | resolved
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@map("inquiries")
}

// --- Public website CMS ----------------------------------------------------
// Portal-managed content that the PUBLIC website renders (news, events, the
// school calendar). Admin-only writes; unauthenticated public read endpoints
// serve only `published` rows. `status` follows the string-union convention
// (lowercase "draft" | "published"). CMS content is text + icon based — the
// public site's photography uses a separate pre-optimized local image
// pipeline that this content doesn't plug into. `icon` holds a ContentIcon
// name the frontend maps to a Lucide icon (validated against an allowlist on
// write).

// `imageId` references a built-in gallery image (rendered via the optimized
// pipeline); `imageObjectKey` is an admin-uploaded image in R2 (served via a
// same-origin proxy). At most one is set; `imageAlt` is the accessible caption.
model NewsArticlePost {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  excerpt          String
  category         String    @default("Updates")
  icon             String    @default("newspaper")
  publishedLabel   String    @default("School Notice")
  imageDescription String    @default("")
  imageId          String?
  imageObjectKey   String?
  imageAlt         String?
  body             Json // NewsBodySection[]: { heading?: string; paragraphs: string[] }
  status           String    @default("draft")
  authorId         String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@map("news_posts")
}

model EventPost {
  id             String   @id @default(cuid())
  title          String
  dateLabel      String   @default("")
  description    String
  icon           String   @default("calendar")
  featured       Boolean  @default(false)
  imageId        String?
  imageObjectKey String?
  imageAlt       String?
  status         String   @default("draft")
  position       Int      @default(0)
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@map("event_posts")
}

model CalendarTermPost {
  id          String   @id @default(cuid())
  name        String
  period      String   @default("")
  description String
  highlights  Json // string[]
  status      String   @default("draft")
  position    Int      @default(0)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("calendar_terms")
}

// A shared photo album for a school event, hosted on Google Photos (which is
// where the school already publishes them). The portal stores the LINK, not the
// photos: no copies, no storage cost, and the school keeps control of the album
// in one place. `albumUrl` is host-allowlisted on write — an admin-authored
// link is published to the public site, so a mistyped or pasted-in address
// must not become a link the school appears to vouch for.
model PhotoAlbumPost {
  id             String    @id @default(cuid())
  title          String
  description    String    @default("")
  // Free-text like "July 2026" or "Graduation 2026" — albums are remembered by
  // occasion, not by a precise date.
  occasionLabel  String    @default("")
  albumUrl       String
  provider       String    @default("google_photos")
  // Optional cover from the built-in gallery or an admin upload, reusing the
  // same picker as news and events.
  imageId        String?
  imageObjectKey String?
  imageAlt       String?
  status         String    @default("draft")
  position       Int       @default(0)
  authorId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@map("photo_albums")
}

// The school-calendar PDF. Effectively a singleton (one active document) —
// uploading a new one replaces the previous row and its R2 object. When a
// `published` document exists the public calendar page shows it as a flipbook
// instead of the term tabs. Bytes live in R2; this row is metadata + object key.
model CalendarDocument {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  objectKey    String
  status       String   @default("draft")
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("calendar_documents")
}
